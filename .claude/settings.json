{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": { "web-kit@my-kits": true },
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)", "PowerShell(python -m pytest *)",
      "Bash(python -m ruff *)", "PowerShell(python -m ruff *)",
      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)",
      "Bash(docker compose ps *)", "Bash(docker compose logs *)"
    ],
    "ask": ["Bash(git push *)", "PowerShell(git push *)"],
    "deny": ["Read(./.env)", "Edit(./.env)"]
  },
  "hooks": {
  "PreToolUse": [
    {
      "matcher": "Bash|PowerShell",
      "hooks": [
        {
          "type": "command",
          "command": "python",
          "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/block_dangerous.py"],
          "onFailure": "block"
        }
      ]
    },
    {
      "matcher": "Edit|Write",
      "hooks": [
        {
          "type": "command",
          "command": "python",
          "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_files.py"],
          "onFailure": "block"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Edit|Write",
      "hooks": [
        {
          "type": "command",
          "command": "python",
          "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format_python.py"],
          "statusMessage": "Formatting with ruff..."
        }
      ]
    }
  ]
}
}
